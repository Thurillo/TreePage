# Systemd template service per i microservizi Python
# Il nome dell'istanza (%i) corrisponde allo slug dello script.
#
# Installa in:  /etc/systemd/system/treepage-script@.service
# Esempio avvio: systemctl enable --now treepage-script@example-script
#
# Lo script deve esporre una FastAPI/Flask app su "main:app"
# e deve avere la porta configurata in scripts_registry.yaml di TreePage.
# Per leggere la porta dal registro usiamo uno script helper (read_port.sh).

[Unit]
Description=TreePage microservice: %i
After=network.target
PartOf=treepage.service

[Service]
Type=exec
User=treepage
Group=treepage
WorkingDirectory=/opt/treepage/scripts/%i

# Legge la porta dal registro YAML e avvia uvicorn
ExecStart=/bin/bash -c '\
  PORT=$(python3 -c "import yaml; d=yaml.safe_load(open(\"/opt/treepage/scripts_registry.yaml\")); print(d[\"scripts\"][\"%i\"][\"port\"])") && \
  /opt/treepage/venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port $PORT \
    --workers 1'

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=treepage-script-%i

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/treepage/scripts/%i

[Install]
WantedBy=multi-user.target
